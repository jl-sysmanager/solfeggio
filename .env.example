# ════════════════════════════════════════════════════════════════════════════
# Solfeggio — variables de entorno (PLANTILLA, sin secretos reales)
# Copia a `.env` para desarrollo local. Los valores `dev-only-…` coinciden con
# docker-compose.yml y sólo valen en local. En producción usa un gestor de
# secretos y genera cada clave con:  openssl rand -base64 32
# Los scripts no leen `.env` solos: `set -a && . ./.env && set +a`.
# ════════════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3000
# Dirección de escucha del API (:: sólo en redes privadas IPv6, p. ej. entornos antiguos de Railway)
HOST=0.0.0.0
# Proxies de confianza delante del API para obtener la IP real (nginx = 1; Railway + nginx = 2)
TRUST_PROXY=1
# Imagen Docker: SERVICE_ROLE=api|worker y RUN_MIGRATIONS=true aplica el release (rol de BD, migraciones,
# planes y administrador) antes de arrancar la API. Ver docs/railway.md
SERVICE_ROLE=api
RUN_MIGRATIONS=false
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
# Orígenes permitidos para CORS, separados por comas (5173 = Vite, 8080 = nginx del compose)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Base de datos ───────────────────────────────────────────────────────────
# Rol de aplicación (no propietario): RLS siempre aplicado. Usado por la API.
DATABASE_URL=postgresql://solfeggio_app:solfeggio_app@localhost:5432/solfeggio
# Rol propietario: SOLO webhooks, worker, panel global y autenticación (Db.system).
SYSTEM_DATABASE_URL=postgresql://solfeggio:solfeggio@localhost:5432/solfeggio
# Rol propietario: SOLO para `prisma migrate deploy` en el paso de release.
DATABASE_MIGRATION_URL=postgresql://solfeggio:solfeggio@localhost:5432/solfeggio

# ── Redis (colas BullMQ y deduplicación de recordatorios) ───────────────────
REDIS_URL=redis://localhost:6379

# ── Almacenamiento S3-compatible (local: SeaweedFS, ver infra/s3/s3.json) ──
S3_ENDPOINT=http://localhost:8333
# Endpoint que ve el navegador para URLs prefirmadas (puede diferir del interno)
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=eu-west-1
S3_BUCKET=solfeggio
S3_ACCESS_KEY_ID=solfeggio-dev
S3_SECRET_ACCESS_KEY=solfeggio-dev-secret
# true para SeaweedFS/MinIO; false para AWS S3
S3_FORCE_PATH_STYLE=true
# Tamaño máximo por archivo subido
MAX_UPLOAD_MB=100

# ── Email ───────────────────────────────────────────────────────────────────
# Respaldo: se usa sólo si no hay configuración en Panel global → Integraciones.
# Local: smtp://localhost:1025 (Mailpit). Producción: smtps://user:pass@host:465
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Solfeggio <no-reply@example.com>"

# ── Autenticación ───────────────────────────────────────────────────────────
# Producción: openssl rand -base64 48 (distintos entre sí, ≥ 32 caracteres)
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000
# Duración del access token (formato ms/vercel: 15m, 1h)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── Cifrado y logs ──────────────────────────────────────────────────────────
# Clave AES-256-GCM: exactamente 32 bytes en base64 → openssl rand -base64 32
DATA_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LTMyLWJ5dGVzLWxvbmctMDAwMDA=
# Clave anterior durante una rotación (opcional): sólo se usa para descifrar
DATA_ENCRYPTION_KEY_PREVIOUS=
# Sal HMAC para seudonimizar IPs en logs y auditoría
LOG_HASH_SALT=dev-only-salt
LOG_LEVEL=info

# ── Rate limiting (en memoria por instancia) ────────────────────────────────
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10

# ── Stripe (usa claves sk_test_ fuera de producción) ────────────────────────
# Respaldo: se usa sólo si no hay configuración en Panel global → Integraciones.
# Vacío y sin configuración en el panel = facturación desactivada (503)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false
# El seed vuelca estos price_… en la tabla plans (vacío = sin precio)
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=
# Días de prueba gratuita si el plan no define los suyos (sólo primera suscripción)
TRIAL_DAYS=14
# Días de servicio completo tras un impago antes de pasar a solo lectura
GRACE_PERIOD_DAYS=7

# ── Observabilidad ──────────────────────────────────────────────────────────
# Si se define, GET /api/v1/metrics exige `Authorization: Bearer <token>`
METRICS_TOKEN=

# ── Seed (solo desarrollo) ──────────────────────────────────────────────────
# Email que el seed marca como administrador de plataforma
PLATFORM_ADMIN_EMAIL=admin@example.com
# Sólo para el release en producción (se crea si el usuario no existe; mínimo 12 caracteres). Elimínala tras el primer acceso
PLATFORM_ADMIN_PASSWORD=
# true = crea la banda de demostración `banda-demo` con datos ficticios
SEED_DEMO=false
# Contraseña de los usuarios creados por el seed (si se omite, valor de desarrollo de seed.ts)
SEED_PASSWORD=

# Latidos externos (copias de seguridad) y rebotes de correo; mínimo 16 caracteres, vacío = endpoint deshabilitado
OPS_HEARTBEAT_TOKEN=
EMAIL_WEBHOOK_TOKEN=
