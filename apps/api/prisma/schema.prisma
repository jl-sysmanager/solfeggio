// Solfeamos — modelo de datos.
//
// Convenciones:
// - Toda tabla de negocio lleva `tenant_id` (columna física) y está protegida por
//   Row Level Security en PostgreSQL (ver migración `0002_rls`). La app conecta con
//   un rol sin privilegios de propietario, por lo que RLS siempre se aplica.
// - Las tablas globales (planes, usuarios, tokens, eventos de Stripe) no llevan RLS
//   y sólo se acceden desde servicios de sistema.
// - Importes en céntimos (Int) y moneda ISO-4217.
// - Datos personales sensibles (DNI, secreto MFA) se guardan cifrados
//   (AES-256-GCM) en columnas `*Enc`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

// ───────────────────────────── Plataforma / SaaS ─────────────────────────────

enum PlanCode {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum TenantStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  READ_ONLY
  SUSPENDED
  CANCELLED
}

enum BillingInterval {
  MONTH
  YEAR
}

model Plan {
  id                 String   @id @default(uuid()) @db.Uuid
  code               PlanCode @unique
  name               String
  priceMonthlyCents  Int
  priceYearlyCents   Int
  currency           String   @default("eur")
  stripePriceMonthly String?
  stripePriceYearly  String?
  maxUsers           Int
  maxMembers         Int
  storageMb          Int
  /// Alumnos de la escuela incluidos en el plan (-1 ilimitado).
  maxStudents        Int      @default(0)
  features           String[]
  trialDays          Int      @default(0)
  active             Boolean  @default(true)
  tenants            Tenant[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("plans")
}

model Tenant {
  id                  String       @id @default(uuid()) @db.Uuid
  slug                String       @unique
  name                String
  legalName           String?
  taxId               String?
  country             String       @default("ES")
  timezone            String       @default("Europe/Madrid")
  locale              String       @default("es-ES")
  status              TenantStatus @default(TRIALING)
  planId              String       @db.Uuid
  plan                Plan         @relation(fields: [planId], references: [id])
  storageUsedBytes    BigInt       @default(0)
  /// Funcionalidades contratadas aparte del plan, gestionadas desde el panel global.
  addons              String[]     @default([])
  /// Plazas de alumno adicionales (legado; la escuela ya no se factura aparte).
  studentSeats        Int          @default(0)
  /// Cupos personalizados (−1 = ilimitado). NULL = usar los del plan.
  maxUsersOverride    Int?
  maxMembersOverride  Int?
  storageMbOverride   Int?
  /// Gestión de cuenta (panel global): etiquetas, gestor asignado y comunidad autónoma para segmentar.
  tags                String[]     @default([])
  accountManagerId    String?      @db.Uuid
  region              String?
  /// Logotipo de la banda (clave S3). Lo sube la propia banda y se muestra en la interfaz y en los documentos.
  logoKey             String?
  logoMime            String?
  /// Cuenta bonificada: sin cobro en Stripe hasta esa fecha (pilotos, bandas benéficas).
  complimentaryUntil  DateTime?
  complimentaryReason String?
  onboardedAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  subscription Subscription?
  memberships  Membership[]

  @@map("tenants")
}

/// Ajustes globales del panel. Una sola fila (`id = default`).
model PlatformConfig {
  id              String   @id
  /// Copias de cada banda que se conservan. Las más antiguas se borran.
  backupRetention Int      @default(30)
  updatedAt       DateTime @updatedAt

  @@map("platform_config")
}

/// Logotipo de la plataforma. Una sola fila (`id = platform`), editable desde el panel global.
model PlatformBrand {
  id       String   @id
  logoKey  String?
  logoMime String?
  updatedAt DateTime @updatedAt

  @@map("platform_brand")
}

model Subscription {
  id                   String           @id @default(uuid()) @db.Uuid
  tenantId             String           @unique @map("tenant_id") @db.Uuid
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  stripeStatus         String?
  interval             BillingInterval?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  cancelAtPeriodEnd    Boolean          @default(false)
  graceUntil           DateTime?
  updatedAt            DateTime         @updatedAt

  @@map("subscriptions")
}

model Invoice {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  stripeInvoiceId String    @unique
  number          String?
  status          String
  currency        String
  subtotalCents   Int
  taxCents        Int
  totalCents      Int
  amountPaidCents Int
  hostedUrl       String?
  pdfUrl          String?
  periodStart     DateTime?
  periodEnd       DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@map("invoices")
}

/// Registro de idempotencia de webhooks: se inserta antes de procesar.
model StripeEvent {
  id          String    @id
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@map("stripe_events")
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// Incidencias de soporte: visibles para el tenant que las abre y para el panel global.
model Incident {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  openedById      String?           @db.Uuid
  subject         String
  body            String
  priority        Int               @default(3)
  status          IncidentStatus    @default(OPEN)
  resolution      String?
  /// Usuario del equipo de plataforma responsable.
  assigneeId      String?           @db.Uuid
  /// Vencimiento de la primera respuesta según la prioridad.
  slaDueAt        DateTime?
  firstResponseAt DateTime?
  slaAlertedAt    DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  messages        IncidentMessage[]

  @@index([tenantId, status])
  @@map("incidents")
}

// ───────────────────────────── Identidad y acceso ─────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String
  passwordHash    String
  mfaEnabled      Boolean   @default(false)
  mfaSecretEnc    String?
  isPlatformAdmin Boolean   @default(false)
  emailVerifiedAt DateTime?
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  /// Bloqueo por moderación: no puede iniciar sesión ni usar tokens emitidos.
  blockedAt       DateTime?
  blockedReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships      Membership[]
  refreshTokens    RefreshToken[]
  passwordResets   PasswordResetToken[]
  emailVerifications EmailVerificationToken[]

  @@map("users")
}

/// Enlace de un solo uso para elegir una contraseña nueva. Se guarda sólo el hash.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Enlace de un solo uso para confirmar que el email del propietario es suyo.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Programación editable del catálogo cerrado de tareas globales.
model ScheduledTask {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  pattern   String
  timezone  String   @default("Europe/Madrid")
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid

  @@map("scheduled_tasks")
}

/// Copia lógica de una banda. Restaurarla sustituye los datos de esa banda y conserva su plan.
model TenantBackup {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  fileKey    String
  checksum   String
  bytes      Int
  createdAt  DateTime  @default(now())
  createdBy  String?   @db.Uuid
  restoredAt DateTime?

  @@index([tenantId, createdAt])
  @@map("tenant_backups")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  tenantId  String?   @db.Uuid
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  key         String
  name        String
  permissions String[]
  isSystem    Boolean      @default(false)
  memberships Membership[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, key])
  @@map("roles")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model Membership {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String           @db.Uuid
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId        String           @db.Uuid
  role          Role             @relation(fields: [roleId], references: [id])
  memberId      String?          @unique @db.Uuid
  member        Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// Tutor de la escuela vinculado (portal de familias).
  guardianId    String?          @unique @db.Uuid
  status        MembershipStatus @default(ACTIVE)
  calendarToken String           @unique @default(uuid()) @db.Uuid
  /// Última petición autenticada en esta banda (como mucho se actualiza una vez por hora).
  lastSeenAt    DateTime?
  /// El propietario pidió no abrir la guía de puesta en marcha al entrar.
  setupGuideDismissedAt DateTime?
  createdAt     DateTime         @default(now())

  @@unique([tenantId, userId])
  @@map("memberships")
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  email      String
  roleId     String    @db.Uuid
  memberId   String?   @db.Uuid
  guardianId String?   @db.Uuid
  tokenHash  String    @unique
  invitedBy  String    @db.Uuid
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@map("invitations")
}

/// Auditoría append-only (el rol de la app no tiene UPDATE/DELETE sobre esta tabla).
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

// ───────────────────────────── Secretaría ─────────────────────────────

enum MemberStatus {
  ACTIVE
  INACTIVE
  LEFT
}

model Section {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  name     String
  position Int      @default(0)
  members  Member[]

  @@unique([tenantId, name])
  @@map("sections")
}

/// Nombres de instrumento configurables por banda (selectores de ficha, escuela, etc.).
model InstrumentCatalogItem {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String
  position Int    @default(0)

  @@unique([tenantId, name])
  @@map("instrument_catalog")
}

model Member {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  memberNumber  Int
  firstName     String
  lastName      String
  email         String?
  phone         String?
  birthDate     DateTime?    @db.Date
  nationalIdEnc String?
  address       String?
  instrument    String?
  /// Segundo instrumento: también abre sus particellas en el archivo.
  secondaryInstrument String?
  sectionId     String?      @db.Uuid
  section       Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  status        MemberStatus @default(ACTIVE)
  joinedAt      DateTime     @default(now()) @db.Date
  leftAt        DateTime?    @db.Date
  leaveReason   String?
  consentDataAt DateTime?
  consentImages Boolean      @default(false)
  notes         String?
  /// Foto de perfil (área `members/photos` en el bucket).
  photoKey      String?
  photoMime     String?
  anonymizedAt  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  membership         Membership?
  sizes              MemberSize[]
  calls              EventCall[]
  attendance         Attendance[]
  feeCharges         FeeCharge[]
  uniformLoans       UniformLoan[]
  instrumentLoans    InstrumentAssignment[]
  student            Student?
  guardians          Guardian[]
  teachers           Teacher[]
  boardPositions     BoardPosition[]
  assemblyAttendance AssemblyAttendance[]   @relation("AssemblyAttendee")
  motionVotes        MotionVote[]
  lotteryBooks       LotteryBook[]
  donors             Donor[]

  @@unique([tenantId, memberNumber])
  @@index([tenantId, status])
  @@index([tenantId, lastName])
  @@map("members")
}

enum CommunicationChannel {
  EMAIL
  IN_APP
}

model Communication {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  subject     String
  body        String
  channel     CommunicationChannel @default(IN_APP)
  /// { all: true } | { sectionIds: [...] } | { memberIds: [...] }
  audience    Json
  recipients  Int                  @default(0)
  createdById String               @db.Uuid
  sentAt      DateTime?
  createdAt   DateTime             @default(now())

  @@index([tenantId, createdAt])
  @@map("communications")
}

model Document {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  title        String
  category     String
  memberId     String?  @db.Uuid
  fileKey      String
  fileName     String
  mimeType     String
  sizeBytes    Int
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())

  @@index([tenantId, category])
  @@map("documents")
}

// ───────────────────────────── Archivo musical ─────────────────────────────

model Composer {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  name        String
  birthYear   Int?
  deathYear   Int?
  nationality String?
  works       Work[]

  @@unique([tenantId, name])
  @@map("composers")
}

model Work {
  id          String                   @id @default(uuid()) @db.Uuid
  tenantId    String                   @map("tenant_id") @db.Uuid
  title       String
  subtitle    String?
  composerId  String?                  @db.Uuid
  composer    Composer?                @relation(fields: [composerId], references: [id], onDelete: SetNull)
  arranger    String?
  genre       String?
  durationSec Int?
  difficulty  Int?
  year        Int?
  publisher   String?
  catalogCode String?
  tags        String[]
  notes       String?
  /// Mantenido por trigger (título, subtítulo, compositor, género, etiquetas).
  search      Unsupported("tsvector")?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  versions     WorkVersion[]
  assets       Asset[]
  repertoire   EventRepertoire[]
  bookletItems BookletItem[]
  scoreLoans   ScoreLoan[]

  @@index([tenantId, title])
  @@index([search], map: "works_search_idx", type: Gin)
  @@index([tags], map: "works_tags_idx", type: Gin)
  @@map("works")
}

model WorkVersion {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  workId    String   @db.Uuid
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  name      String
  arranger  String?
  notes     String?
  createdAt DateTime @default(now())
  assets    Asset[]

  @@map("work_versions")
}

enum AssetKind {
  SCORE
  PART
  AUDIO
  OTHER
}

model Asset {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  workId       String       @db.Uuid
  work         Work         @relation(fields: [workId], references: [id], onDelete: Cascade)
  versionId    String?      @db.Uuid
  version      WorkVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  kind         AssetKind
  instrument   String?
  fileKey      String
  fileName     String
  mimeType     String
  sizeBytes    Int
  uploadedById String       @db.Uuid
  createdAt    DateTime     @default(now())

  @@index([tenantId, workId])
  @@map("assets")
}

// ───────────────────────────── Ensayos, actuaciones y agenda ─────────────────────────────

enum EventType {
  REHEARSAL
  PERFORMANCE
  MEETING
  OTHER
}

enum EventStatus {
  SCHEDULED
  CANCELLED
  DONE
}

enum CallResponse {
  PENDING
  ACCEPTED
  DECLINED
}

model Event {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  type            EventType
  title           String
  description     String?
  location        String?
  startsAt        DateTime
  endsAt          DateTime
  status          EventStatus @default(SCHEDULED)
  reminderMinutes Int[]       @default([1440])
  createdById     String      @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  repertoire     EventRepertoire[]
  calls          EventCall[]
  attendance     Attendance[]
  requirements   EventRequirement[]
  logistics      EventLogistics?
  quotes         PerformanceQuote[]
  reinforcements ReinforcementRequest[]

  @@index([tenantId, startsAt])
  @@map("events")
}

model EventRepertoire {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  eventId  String  @db.Uuid
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  workId   String  @db.Uuid
  work     Work    @relation(fields: [workId], references: [id], onDelete: Cascade)
  position Int
  notes    String?

  @@unique([eventId, workId])
  @@map("event_repertoire")
}

/// Convocatoria de un socio a un evento.
model EventCall {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  eventId     String       @db.Uuid
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId    String       @db.Uuid
  member      Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  response    CallResponse @default(PENDING)
  respondedAt DateTime?
  note        String?

  @@unique([eventId, memberId])
  @@map("event_calls")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum JustificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model Attendance {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @map("tenant_id") @db.Uuid
  eventId             String              @db.Uuid
  event               Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId            String              @db.Uuid
  member              Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status              AttendanceStatus
  justification       String?
  justificationStatus JustificationStatus @default(NONE)
  recordedById        String              @db.Uuid
  recordedAt          DateTime            @default(now())

  @@unique([eventId, memberId])
  @@index([tenantId, memberId])
  @@map("attendance")
}

// ───────────────────────────── Tesorería ─────────────────────────────

enum TxKind {
  INCOME
  EXPENSE
}

enum Periodicity {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_OFF
}

enum ChargeStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

model FinanceCategory {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  name         String
  kind         TxKind
  transactions Transaction[]

  @@unique([tenantId, name, kind])
  @@map("finance_categories")
}

model Transaction {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  kind        TxKind
  amountCents Int
  currency    String           @default("eur")
  date        DateTime         @db.Date
  categoryId  String?          @db.Uuid
  category    FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description String
  memberId    String?          @db.Uuid
  receiptKey  String?
  /// Subvención a la que se imputa el movimiento (justificación).
  grantId     String?          @db.Uuid
  grant       Grant?           @relation(fields: [grantId], references: [id], onDelete: SetNull)
  createdById String           @db.Uuid
  createdAt   DateTime         @default(now())

  @@index([tenantId, date])
  @@index([tenantId, grantId])
  @@map("transactions")
}

model Fee {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  name        String
  amountCents Int
  periodicity Periodicity
  active      Boolean     @default(true)
  charges     FeeCharge[]

  @@map("fees")
}

model FeeCharge {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  feeId         String       @db.Uuid
  fee           Fee          @relation(fields: [feeId], references: [id], onDelete: Cascade)
  memberId      String       @db.Uuid
  member        Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  period        String
  amountCents   Int
  dueDate       DateTime     @db.Date
  status        ChargeStatus @default(PENDING)
  paidAt        DateTime?
  transactionId String?      @db.Uuid

  @@unique([feeId, memberId, period])
  @@index([tenantId, status])
  @@map("fee_charges")
}

// ───────────────────────────── Mayordomía (uniformes) ─────────────────────────────

enum ItemCondition {
  NEW
  GOOD
  WORN
  DAMAGED
}

enum StockStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

model MemberSize {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  memberId String @db.Uuid
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  garment  String
  size     String

  @@unique([memberId, garment])
  @@map("member_sizes")
}

model UniformItem {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  code      String
  garment   String
  size      String
  condition ItemCondition @default(GOOD)
  status    StockStatus   @default(AVAILABLE)
  notes     String?
  loans     UniformLoan[]
  createdAt DateTime      @default(now())

  @@unique([tenantId, code])
  @@map("uniform_items")
}

model UniformLoan {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  itemId       String         @db.Uuid
  item         UniformItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  memberId     String         @db.Uuid
  member       Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  deliveredAt  DateTime       @default(now())
  dueAt        DateTime?
  returnedAt   DateTime?
  conditionOut ItemCondition
  conditionIn  ItemCondition?
  notes        String?

  @@index([tenantId, itemId])
  @@map("uniform_loans")
}

// ───────────────────────────── Instrumentación ─────────────────────────────

enum MaintenanceType {
  MAINTENANCE
  REPAIR
}

enum MaintenanceStatus {
  OPEN
  DONE
}

model Instrument {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  inventoryCode      String
  type               String
  brand              String?
  model              String?
  serialNumber       String?
  purchaseDate       DateTime?     @db.Date
  purchasePriceCents Int?
  condition          ItemCondition @default(GOOD)
  status             StockStatus   @default(AVAILABLE)
  notes              String?
  createdAt          DateTime      @default(now())

  assignments InstrumentAssignment[]
  maintenance MaintenanceRecord[]

  @@unique([tenantId, inventoryCode])
  @@map("instruments")
}

model InstrumentAssignment {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  instrumentId String     @db.Uuid
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  memberId     String     @db.Uuid
  member       Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  startAt      DateTime   @default(now())
  endAt        DateTime?
  notes        String?

  @@index([tenantId, instrumentId])
  @@map("instrument_assignments")
}

model MaintenanceRecord {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  instrumentId String            @db.Uuid
  instrument   Instrument        @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  type         MaintenanceType
  description  String
  provider     String?
  costCents    Int?
  status       MaintenanceStatus @default(OPEN)
  startedAt    DateTime          @default(now())
  completedAt  DateTime?

  @@index([tenantId, instrumentId])
  @@map("maintenance_records")
}

// ───────────────────────────── BandMarket ─────────────────────────────
// Marketplace entre bandas: los anuncios PUBLISHED son visibles para todos los
// tenants; sólo el tenant vendedor puede modificarlos. La moderación la realiza
// el equipo de plataforma. La compraventa se cierra fuera de la plataforma (MVP).

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SOLD
  ARCHIVED
}

model Listing {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  createdById    String        @db.Uuid
  title          String
  description    String
  category       String
  condition      ItemCondition
  priceCents     Int
  currency       String        @default("eur")
  location       String?
  imageKeys      String[]
  status         ListingStatus @default(DRAFT)
  moderationNote String?
  submittedAt    DateTime?
  moderatedAt    DateTime?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  inquiries ListingInquiry[]
  reports   ListingReport[]

  @@index([status, category])
  @@index([tenantId])
  @@map("listings")
}

model ListingInquiry {
  id             String   @id @default(uuid()) @db.Uuid
  listingId      String   @db.Uuid
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sellerTenantId String   @db.Uuid
  buyerTenantId  String   @db.Uuid
  fromUserId     String   @db.Uuid
  message        String
  createdAt      DateTime @default(now())

  @@index([listingId])
  @@map("listing_inquiries")
}

model ListingReport {
  id               String    @id @default(uuid()) @db.Uuid
  listingId        String    @db.Uuid
  listing          Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterTenantId String    @db.Uuid
  reason           String
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@map("listing_reports")
}

// ───────────────────────────── Integraciones de plataforma ─────────────────────────────
// Configuración global de terceros (pagos, correo…) editable desde el panel de administración.
// Una fila por categoría con el proveedor activo. Los campos no sensibles van en `config`; los
// secretos, en `secretsEnc` cifrados con AES-256-GCM y la categoría como dato autenticado (AAD),
// de modo que un cifrado no puede trasladarse a otra fila. Sólo el rol de sistema accede.

model IntegrationSetting {
  id          String   @id @default(uuid()) @db.Uuid
  category    String   @unique
  provider    String
  enabled     Boolean  @default(false)
  config      Json     @default("{}")
  secretsEnc  String?
  /// Últimos 4 caracteres de cada secreto, para identificarlo en la UI sin revelarlo.
  secretHints Json     @default("{}")
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("integration_settings")
}

/// Auditoría de acciones globales del equipo de plataforma (append-only).
model PlatformAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
  @@map("platform_audit_logs")
}

// ───────────────────────────── Escuela de música ─────────────────────────────
// Los alumnos no son socios: se agrupan en familias (hermanos y tutores comparten familia) y
// pueden pasar a la banda como educandos o músicos, creando su ficha de socio (`memberId`).

enum StudentStatus {
  ACTIVE
  INACTIVE
  LEFT
}

/// Cómo se calcula la mensualidad: descuentos en % o una tarifa fija asignada al alumno.
enum SchoolFeeMode {
  PERCENT
  FIXED
}

enum StudentBandStage {
  NONE
  EDUCANDO
  MUSICIAN
}

model SchoolSettings {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @unique @map("tenant_id") @db.Uuid
  /// PERCENT: descuentos en % sobre las asignaturas. FIXED: tarifa mensual asignada al alumno.
  feeMode                 SchoolFeeMode @default(PERCENT)
  /// Descuentos en porcentaje sobre la mensualidad.
  siblingDiscountPct      Int      @default(0)
  memberDiscountPct       Int      @default(0)
  multiSubjectDiscountPct Int      @default(0)
  /// Importe fijo que se resta a cada alumno adicional de la misma familia.
  familyDiscountCents     Int      @default(0)
  /// Texto de presentación del formulario público de matrícula.
  publicIntro             String?
  /// Día del mes (1–28) en que se emiten solas las mensualidades del curso actual. Nulo: emisión manual.
  autoIssueDay            Int?
  /// Día del mes en que vencen las mensualidades emitidas solas.
  autoIssueDueDay         Int      @default(5)
  /// Avisar por email a las familias de matrículas resueltas y recibos emitidos.
  notifyFamilies          Boolean  @default(true)
  updatedAt               DateTime @updatedAt

  @@map("school_settings")
}

/// Precio mensual fijo. En modo FIXED sustituye a la suma de asignaturas y a los descuentos.
model TuitionTariff {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  monthlyCents Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  students     Student[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tuition_tariffs")
}

model Family {
  id         String          @id @default(uuid()) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  name       String
  notes      String?
  createdAt  DateTime        @default(now())
  students   Student[]
  guardians  Guardian[]
  charges    TuitionCharge[]

  @@index([tenantId, name])
  @@map("families")
}

model Guardian {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  familyId      String   @db.Uuid
  family        Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  relationship  String?
  email         String?
  phone         String?
  nationalIdEnc String?
  /// Socio de la banda (aplica el descuento de socio).
  memberId      String?  @db.Uuid
  member        Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([tenantId, familyId])
  @@map("guardians")
}

model Student {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  familyId         String?          @db.Uuid
  family           Family?          @relation(fields: [familyId], references: [id], onDelete: SetNull)
  firstName        String
  lastName         String
  birthDate        DateTime?        @db.Date
  email            String?
  phone            String?
  instrument       String?
  imageConsent     Boolean          @default(false)
  /// Personas autorizadas a recoger al alumno (nombre y DNI parcial, texto libre).
  pickupAuthorized String[]
  status           StudentStatus    @default(ACTIVE)
  bandStage        StudentBandStage @default(NONE)
  memberId         String?          @unique @db.Uuid
  member           Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)
  notes            String?
  /// Tarifa mensual fija. Sólo se cobra así cuando la escuela está en modo FIXED.
  tuitionTariffId  String?          @db.Uuid
  tuitionTariff    TuitionTariff?   @relation(fields: [tuitionTariffId], references: [id], onDelete: Restrict)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  enrollments     Enrollment[]
  classAttendance ClassAttendance[]
  charges         TuitionCharge[]

  @@index([tenantId, status])
  @@index([tenantId, lastName])
  @@map("students")
}

model SchoolYear {
  id             String                  @id @default(uuid()) @db.Uuid
  tenantId       String                  @map("tenant_id") @db.Uuid
  name           String
  startsOn       DateTime                @db.Date
  endsOn         DateTime                @db.Date
  /// Festivos y días sin clase.
  holidays       DateTime[]              @db.Date
  enrollmentOpen Boolean                 @default(false)
  isCurrent      Boolean                 @default(false)
  createdAt      DateTime                @default(now())
  groups         ClassGroup[]
  applications   EnrollmentApplication[]
  charges        TuitionCharge[]

  @@unique([tenantId, name])
  @@map("school_years")
}

enum SubjectKind {
  INSTRUMENT
  THEORY
  ENSEMBLE
  OTHER
}

model Subject {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  name            String
  kind            SubjectKind
  monthlyFeeCents Int          @default(0)
  active          Boolean      @default(true)
  groups          ClassGroup[]

  @@unique([tenantId, name])
  @@map("subjects")
}

model Teacher {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  firstName String
  lastName  String
  email     String?
  phone     String?
  /// Usuario de la plataforma (para «mis grupos»).
  userId    String?      @db.Uuid
  memberId  String?      @db.Uuid
  member    Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  active    Boolean      @default(true)
  groups    ClassGroup[]

  @@map("teachers")
}

model Room {
  id       String      @id @default(uuid()) @db.Uuid
  tenantId String      @map("tenant_id") @db.Uuid
  name     String
  capacity Int?
  slots    ClassSlot[]

  @@unique([tenantId, name])
  @@map("rooms")
}

model ClassGroup {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  yearId          String         @db.Uuid
  year            SchoolYear     @relation(fields: [yearId], references: [id], onDelete: Cascade)
  subjectId       String         @db.Uuid
  subject         Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  name            String
  level           String?
  teacherId       String?        @db.Uuid
  teacher         Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  capacity        Int?
  /// Precio propio del grupo; si es nulo se usa el de la asignatura.
  monthlyFeeCents Int?
  createdAt       DateTime       @default(now())
  slots           ClassSlot[]
  enrollments     Enrollment[]
  sessions        ClassSession[]
  notices         SchoolNotice[]

  @@index([tenantId, yearId])
  @@map("class_groups")
}

/// Franja semanal de un grupo. Minutos desde medianoche.
model ClassSlot {
  id       String     @id @default(uuid()) @db.Uuid
  tenantId String     @map("tenant_id") @db.Uuid
  groupId  String     @db.Uuid
  group    ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// 1 = lunes … 7 = domingo.
  weekday  Int
  startMin Int
  endMin   Int
  roomId   String?    @db.Uuid
  room     Room?      @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([tenantId, weekday])
  @@map("class_slots")
}

enum EnrollmentStatus {
  ACTIVE
  WAITLIST
  WITHDRAWN
}

model Enrollment {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  studentId   String           @db.Uuid
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId     String           @db.Uuid
  group       ClassGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  withdrawnAt DateTime?
  grades      Grade[]

  @@unique([groupId, studentId])
  @@index([tenantId, studentId])
  @@map("enrollments")
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  WAITLISTED
  REJECTED
}

/// Solicitud de matrícula recibida por el formulario público (o renovación).
model EnrollmentApplication {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  yearId           String            @db.Uuid
  year             SchoolYear        @relation(fields: [yearId], references: [id], onDelete: Cascade)
  status           ApplicationStatus @default(PENDING)
  renewal          Boolean           @default(false)
  studentFirstName String
  studentLastName  String
  studentBirthDate DateTime?         @db.Date
  guardianName     String
  guardianEmail    String
  guardianPhone    String?
  subjectIds       String[]          @db.Uuid
  notes            String?
  consentAt        DateTime
  /// Prueba de acceso.
  auditionAt       DateTime?
  auditionResult   String?
  studentId        String?           @db.Uuid
  reviewedAt       DateTime?
  createdAt        DateTime          @default(now())

  @@index([tenantId, status])
  @@map("enrollment_applications")
}

enum ClassSessionStatus {
  SCHEDULED
  CANCELLED
  DONE
}

model ClassSession {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  groupId     String             @db.Uuid
  group       ClassGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date        DateTime           @db.Date
  startMin    Int
  endMin      Int
  status      ClassSessionStatus @default(SCHEDULED)
  /// Clase de recuperación de otra cancelada.
  makeUpForId String?            @db.Uuid
  notes       String?
  attendance  ClassAttendance[]

  @@unique([groupId, date, startMin])
  @@index([tenantId, date])
  @@map("class_sessions")
}

model ClassAttendance {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  sessionId String           @db.Uuid
  session   ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String           @db.Uuid
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus
  note      String?

  @@unique([sessionId, studentId])
  @@index([tenantId, studentId])
  @@map("class_attendance")
}

model Grade {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  enrollmentId String     @db.Uuid
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// Trimestre: 1, 2 o 3 (4 = final).
  term         Int
  /// Nota numérica de 0 a 10, en décimas (0–100).
  scoreTenths  Int?
  qualitative  String?
  comment      String?
  updatedAt    DateTime   @updatedAt

  @@unique([enrollmentId, term])
  @@map("grades")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  DIRECT_DEBIT
  BIZUM
  OTHER
}

model TuitionCharge {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  yearId        String       @db.Uuid
  year          SchoolYear   @relation(fields: [yearId], references: [id], onDelete: Cascade)
  studentId     String       @db.Uuid
  student       Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  familyId      String?      @db.Uuid
  family        Family?      @relation(fields: [familyId], references: [id], onDelete: SetNull)
  /// Periodo `YYYY-MM`.
  period        String
  baseCents     Int
  discountCents Int          @default(0)
  amountCents   Int
  /// Líneas: asignaturas y descuentos aplicados.
  detail        Json
  dueDate       DateTime     @db.Date
  status        ChargeStatus @default(PENDING)
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  transactionId String?      @db.Uuid

  @@unique([studentId, period])
  @@index([tenantId, period])
  @@map("tuition_charges")
}

model SchoolNotice {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  /// Nulo: aviso para toda la escuela.
  groupId   String?     @db.Uuid
  group     ClassGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title     String
  body      String
  authorId  String      @db.Uuid
  createdAt DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@map("school_notices")
}

// ───────────────────────────── Actuaciones y contrataciones ─────────────────────────────

enum ClientKind {
  CITY_COUNCIL
  BROTHERHOOD
  FESTIVAL_COMMITTEE
  PRIVATE
  OTHER
}

model Client {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  name        String
  kind        ClientKind         @default(OTHER)
  taxId       String?
  email       String?
  phone       String?
  address     String?
  contactName String?
  notes       String?
  createdAt   DateTime           @default(now())
  quotes      PerformanceQuote[]
  invoices    ClientInvoice[]

  @@index([tenantId, name])
  @@map("clients")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

/// Presupuesto; aceptado y firmado hace las veces de contrato.
model PerformanceQuote {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  number        Int
  clientId      String          @db.Uuid
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  eventId       String?         @db.Uuid
  event         Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  title         String
  performanceAt DateTime?
  location      String?
  /// [{ description, quantity, unitCents }]
  lines         Json
  taxRatePct    Int             @default(0)
  baseCents     Int
  taxCents      Int
  totalCents    Int
  validUntil    DateTime?       @db.Date
  status        QuoteStatus     @default(DRAFT)
  contractTerms String?
  signedAt      DateTime?
  signedBy      String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  invoices      ClientInvoice[]

  @@unique([tenantId, number])
  @@map("performance_quotes")
}

enum InvoiceStatus {
  ISSUED
  PAID
  CANCELLED
}

/// Factura emitida a un cliente. Inalterable tras su emisión: cada registro encadena la huella
/// (SHA-256) del anterior de la misma serie, como exige el reglamento VeriFactu.
model ClientInvoice {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  series         String            @default("A")
  number         Int
  issueDate      DateTime          @db.Date
  clientId       String            @db.Uuid
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  quoteId        String?           @db.Uuid
  quote          PerformanceQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  /// Datos del cliente en el momento de emitir.
  clientSnapshot Json
  lines          Json
  taxRatePct     Int
  baseCents      Int
  taxCents       Int
  totalCents     Int
  status         InvoiceStatus     @default(ISSUED)
  /// Factura rectificada por ésta.
  rectifiesId    String?           @db.Uuid
  paidAt         DateTime?
  transactionId  String?           @db.Uuid
  hash           String
  prevHash       String?
  createdAt      DateTime          @default(now())

  @@unique([tenantId, series, number])
  @@map("client_invoices")
}

/// Plantilla mínima por instrumento para un evento.
model EventRequirement {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  eventId    String @db.Uuid
  event      Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  instrument String
  required   Int

  @@unique([eventId, instrument])
  @@map("event_requirements")
}

model EventLogistics {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  eventId        String    @unique @db.Uuid
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  transport      String?
  departurePlace String?
  departureAt    DateTime?
  returnAt       DateTime?
  route          String?
  uniform        String?
  notes          String?
  updatedAt      DateTime  @updatedAt

  @@map("event_logistics")
}

// ───────────────────────────── Bolsa de refuerzos ─────────────────────────────
// Las necesidades OPEN son visibles para todas las bandas (como BandMarket). Los perfiles de
// músico son globales (por usuario) y las candidaturas las gestiona el sistema con comprobaciones
// explícitas, porque las crea un usuario para una banda que no es la suya.

model MusicianProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  displayName String
  instruments String[]
  province    String
  city        String?
  bio         String?
  available   Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@index([province])
  @@map("musician_profiles")
}

enum ReinforcementStatus {
  OPEN
  FILLED
  CANCELLED
}

model ReinforcementRequest {
  id           String                     @id @default(uuid()) @db.Uuid
  tenantId     String                     @map("tenant_id") @db.Uuid
  eventId      String?                    @db.Uuid
  event        Event?                     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  title        String
  instrument   String
  quantity     Int                        @default(1)
  date         DateTime
  province     String
  location     String?
  feeCents     Int?
  description  String?
  status       ReinforcementStatus        @default(OPEN)
  createdById  String                     @db.Uuid
  createdAt    DateTime                   @default(now())
  applications ReinforcementApplication[]

  @@index([status, province, instrument])
  @@index([tenantId])
  @@map("reinforcement_requests")
}

enum ApplicationDecision {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model ReinforcementApplication {
  id        String               @id @default(uuid()) @db.Uuid
  /// Banda que publicó la necesidad.
  tenantId  String               @map("tenant_id") @db.Uuid
  requestId String               @db.Uuid
  request   ReinforcementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String               @db.Uuid
  message   String?
  status    ApplicationDecision  @default(PENDING)
  createdAt DateTime             @default(now())

  @@unique([requestId, userId])
  @@map("reinforcement_applications")
}

/// Músico externo (refuerzo) con NIF cifrado para retenciones.
model ExternalMusician {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  userId        String?                @db.Uuid
  firstName     String
  lastName      String
  instrument    String?
  email         String?
  phone         String?
  nationalIdEnc String?
  createdAt     DateTime               @default(now())
  payments      ReinforcementPayment[]

  @@index([tenantId, lastName])
  @@map("external_musicians")
}

model ReinforcementPayment {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  musicianId       String           @db.Uuid
  musician         ExternalMusician @relation(fields: [musicianId], references: [id], onDelete: Restrict)
  eventId          String?          @db.Uuid
  concept          String
  date             DateTime         @db.Date
  grossCents       Int
  withholdingPct   Int              @default(15)
  withholdingCents Int
  netCents         Int
  paidAt           DateTime?
  transactionId    String?          @db.Uuid
  createdAt        DateTime         @default(now())

  @@index([tenantId, date])
  @@map("reinforcement_payments")
}

// ───────────────────────────── Archivo: libretos y préstamos ─────────────────────────────

model Booklet {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime      @default(now())
  items       BookletItem[]

  @@unique([tenantId, name])
  @@map("booklets")
}

model BookletItem {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  bookletId String  @db.Uuid
  booklet   Booklet @relation(fields: [bookletId], references: [id], onDelete: Cascade)
  workId    String  @db.Uuid
  work      Work    @relation(fields: [workId], references: [id], onDelete: Cascade)
  position  Int
  /// Número de la marcha en el libreto (p. ej. «12»).
  label     String?

  @@unique([bookletId, workId])
  @@map("booklet_items")
}

enum LoanDirection {
  LENT
  BORROWED
}

model ScoreLoan {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  workId       String        @db.Uuid
  work         Work          @relation(fields: [workId], references: [id], onDelete: Cascade)
  direction    LoanDirection
  counterparty String
  contact      String?
  loanedAt     DateTime      @db.Date
  dueAt        DateTime?     @db.Date
  returnedAt   DateTime?     @db.Date
  notes        String?
  createdAt    DateTime      @default(now())

  @@index([tenantId, returnedAt])
  @@map("score_loans")
}

// ───────────────────────────── Gobierno de la asociación ─────────────────────────────

enum AssemblyType {
  ORDINARY
  EXTRAORDINARY
}

enum AssemblyStatus {
  DRAFT
  CONVENED
  HELD
  CLOSED
}

model Assembly {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  type              AssemblyType
  title             String
  firstCallAt       DateTime
  secondCallAt      DateTime?
  location          String?
  /// [{ title, description }]
  agenda            Json
  /// Quórum exigido en primera convocatoria (porcentaje de socios activos).
  quorumPct         Int                  @default(50)
  status            AssemblyStatus       @default(DRAFT)
  convenedAt        DateTime?
  minutes           String?
  minutesApprovedAt DateTime?
  createdAt         DateTime             @default(now())
  attendance        AssemblyAttendance[]
  motions           Motion[]

  @@index([tenantId, firstCallAt])
  @@map("assemblies")
}

model AssemblyAttendance {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  assemblyId String   @db.Uuid
  assembly   Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  memberId   String   @db.Uuid
  member     Member   @relation("AssemblyAttendee", fields: [memberId], references: [id], onDelete: Cascade)
  /// Socio que delega su voto en `memberId`.
  proxyForId String?  @db.Uuid

  @@unique([assemblyId, memberId, proxyForId])
  @@map("assembly_attendance")
}

enum MotionStatus {
  DRAFT
  OPEN
  CLOSED
}

model Motion {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  assemblyId  String       @db.Uuid
  assembly    Assembly     @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  allowRemote Boolean      @default(true)
  status      MotionStatus @default(DRAFT)
  openedAt    DateTime?
  closedAt    DateTime?
  votes       MotionVote[]

  @@map("motions")
}

enum VoteChoice {
  YES
  NO
  ABSTAIN
}

model MotionVote {
  id       String     @id @default(uuid()) @db.Uuid
  tenantId String     @map("tenant_id") @db.Uuid
  motionId String     @db.Uuid
  motion   Motion     @relation(fields: [motionId], references: [id], onDelete: Cascade)
  memberId String     @db.Uuid
  member   Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  choice   VoteChoice
  remote   Boolean    @default(false)
  castAt   DateTime   @default(now())

  @@unique([motionId, memberId])
  @@map("motion_votes")
}

model BoardPosition {
  id       String    @id @default(uuid()) @db.Uuid
  tenantId String    @map("tenant_id") @db.Uuid
  memberId String    @db.Uuid
  member   Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  position String
  startsOn DateTime  @db.Date
  endsOn   DateTime? @db.Date
  notes    String?

  @@index([tenantId, endsOn])
  @@map("board_positions")
}

model Poll {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  question    String
  options     String[]
  multiple    Boolean    @default(false)
  anonymous   Boolean    @default(false)
  closesAt    DateTime?
  closedAt    DateTime?
  createdById String     @db.Uuid
  createdAt   DateTime   @default(now())
  votes       PollVote[]

  @@index([tenantId, createdAt])
  @@map("polls")
}

model PollVote {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  pollId       String   @db.Uuid
  poll         Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  membershipId String   @db.Uuid
  choices      Int[]
  castAt       DateTime @default(now())

  @@unique([pollId, membershipId])
  @@map("poll_votes")
}

// ───────────────────────────── Tesorería: subvenciones, lotería y donantes ─────────────────────────────

enum GrantStatus {
  REQUESTED
  AWARDED
  JUSTIFIED
  CLOSED
  REJECTED
}

model Grant {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  name             String
  grantor          String
  reference        String?
  year             Int
  requestedCents   Int?
  awardedCents     Int?
  awardedAt        DateTime?     @db.Date
  justificationDue DateTime?     @db.Date
  status           GrantStatus   @default(REQUESTED)
  notes            String?
  createdAt        DateTime      @default(now())
  transactions     Transaction[]

  @@index([tenantId, year])
  @@map("grants")
}

model LotteryDraw {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  name             String
  drawDate         DateTime      @db.Date
  numbers          String[]
  /// Precio de venta de cada participación y parte que se juega; la diferencia es el donativo.
  ticketPriceCents Int
  stakeCents       Int
  notes            String?
  createdAt        DateTime      @default(now())
  books            LotteryBook[]

  @@unique([tenantId, name])
  @@map("lottery_draws")
}

model LotteryBook {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  drawId          String      @db.Uuid
  draw            LotteryDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)
  code            String
  number          String?
  memberId        String?     @db.Uuid
  member          Member?     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  holderName      String?
  tickets         Int
  returnedTickets Int         @default(0)
  paidCents       Int         @default(0)
  settledAt       DateTime?
  transactionId   String?     @db.Uuid
  issuedAt        DateTime    @default(now())

  @@unique([drawId, code])
  @@map("lottery_books")
}

enum DonorKind {
  PERSON
  COMPANY
}

model Donor {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  kind       DonorKind  @default(PERSON)
  name       String
  taxIdEnc   String?
  /// Últimos caracteres del NIF, para identificarlo sin descifrar.
  taxIdHint  String?
  address    String?
  postalCode String?
  /// Código de provincia de dos dígitos (modelo 182).
  province   String?
  email      String?
  memberId   String?    @db.Uuid
  member     Member?    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  sponsor    Boolean    @default(false)
  createdAt  DateTime   @default(now())
  donations  Donation[]

  @@index([tenantId, name])
  @@map("donors")
}

enum DonationKind {
  DONATION
  SPONSORSHIP
}

model Donation {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  donorId       String       @db.Uuid
  donor         Donor        @relation(fields: [donorId], references: [id], onDelete: Cascade)
  kind          DonationKind @default(DONATION)
  date          DateTime     @db.Date
  amountCents   Int
  inKind        Boolean      @default(false)
  description   String?
  transactionId String?      @db.Uuid
  createdAt     DateTime     @default(now())

  @@index([tenantId, date])
  @@map("donations")
}

// ───────────────────────────── Panel global: negocio, soporte y operación ─────────────────────────────
// Tablas de plataforma. Salvo `incident_messages` (visible para la banda sin las notas internas),
// sólo las usa el cliente de sistema desde el panel global y el worker.

/// Foto diaria de cada banda: base de las métricas SaaS (MRR, cohortes) y de la salud del cliente.
model TenantSnapshot {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  date           DateTime     @db.Date
  planCode       PlanCode
  status         TenantStatus
  /// Ingreso mensual recurrente normalizado (anual / 12), incluidos add-ons.
  mrrCents       Int
  activeUsers7d  Int
  activeUsers30d Int
  members        Int
  students       Int
  storageBytes   BigInt
  /// Actividad de los últimos 30 días por módulo, p. ej. { events: 12, attendance: 40, treasury: 9 }.
  usage          Json
  healthScore    Int
  createdAt      DateTime     @default(now())

  @@unique([tenantId, date])
  @@index([date])
  @@map("tenant_snapshots")
}

model TenantNote {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("tenant_notes")
}

/// Acceso de solo lectura del equipo de plataforma a una banda («ver como»).
model ImpersonationSession {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  adminId   String    @db.Uuid
  reason    String
  expiresAt DateTime
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@map("impersonation_sessions")
}

/// Conversación de una incidencia. Las notas internas no son visibles para la banda.
model IncidentMessage {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  incidentId String   @db.Uuid
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  /// PLATFORM o TENANT.
  authorType String
  authorId   String?  @db.Uuid
  body       String
  internal   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_messages")
}

model CannedReply {
  id        String   @id @default(uuid()) @db.Uuid
  title     String   @unique
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("canned_replies")
}

enum AnnouncementLevel {
  INFO
  WARNING
  MAINTENANCE
}

/// Aviso dentro de la app para las bandas de un segmento.
model Announcement {
  id          String                  @id @default(uuid()) @db.Uuid
  title       String
  body        String
  level       AnnouncementLevel       @default(INFO)
  link        String?
  startsAt    DateTime
  endsAt      DateTime?
  /// { plans?: PlanCode[], regions?: string[], features?: string[], tenantIds?: uuid[] }; vacío = todas.
  segment     Json                    @default("{}")
  dismissible Boolean                 @default(true)
  createdById String                  @db.Uuid
  createdAt   DateTime                @default(now())
  dismissals  AnnouncementDismissal[]

  @@index([startsAt])
  @@map("announcements")
}

model AnnouncementDismissal {
  id             String       @id @default(uuid()) @db.Uuid
  announcementId String       @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  dismissedAt    DateTime     @default(now())

  @@unique([announcementId, userId])
  @@map("announcement_dismissals")
}

/// Envíos de correo (resultado del worker y rebotes notificados por el proveedor).
model EmailLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  to        String
  subject   String
  /// SENT, FAILED, BOUNCED o COMPLAINED.
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@map("email_logs")
}

/// Latido de procesos externos o periódicos (copias de seguridad, tareas programadas).
model OpsHeartbeat {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  status    String
  detail    Json?
  lastRunAt DateTime
  updatedAt DateTime @updatedAt

  @@map("ops_heartbeats")
}

/// Denuncia de una necesidad o un perfil de la bolsa de refuerzos.
model ReinforcementReport {
  id               String    @id @default(uuid()) @db.Uuid
  requestId        String?   @db.Uuid
  profileId        String?   @db.Uuid
  reporterTenantId String    @db.Uuid
  reporterUserId   String    @db.Uuid
  reason           String
  resolvedAt       DateTime?
  resolution       String?
  createdAt        DateTime  @default(now())

  @@index([resolvedAt])
  @@map("reinforcement_reports")
}
