{
  "name": "@solfeggio/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=src",
    "test:e2e": "jest --runInBand --testPathPattern=test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "openapi": "ts-node --transpile-only scripts/openapi.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@nestjs/common": "^10.4",
    "@nestjs/core": "^10.4",
    "@nestjs/jwt": "^10.2",
    "@nestjs/platform-express": "^10.4",
    "@nestjs/schedule": "^4",
    "@nestjs/swagger": "^8",
    "@nestjs/throttler": "^6",
    "@prisma/client": "^5.22",
    "argon2": "^0.45.1",
    "bullmq": "^5",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.1",
    "helmet": "^8",
    "ioredis": "^5",
    "nestjs-pino": "^4",
    "nodemailer": "^10.1.7",
    "otplib": "^12.0.1",
    "pdf-lib": "1.17.1",
    "pino": "^9",
    "pino-http": "^10",
    "prisma": "^5.22",
    "prom-client": "^15",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^17",
    "unpdf": "1.8.1",
    "zod": "^3.23",
    "zod-to-json-schema": "^3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10",
    "@nestjs/testing": "^10.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4",
    "@types/jest": "^29",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^9",
    "jest": "^29",
    "pino-pretty": "^13.2.0",
    "supertest": "^7",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "~5.6",
    "typescript-eslint": "^8"
  }
}
